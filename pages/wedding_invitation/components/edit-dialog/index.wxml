<!-- 用 hidden 代替 wx:if，避免关闭弹窗同时改画布时触发 FLOW_CREATE_NODE -->
<view class="edit-dialog" hidden="{{!visible}}" catchtouchmove="noop">
  <view class="edit-dialog__mask" catchtap="onCancel" />
  <view class="edit-dialog__panel">
    <view class="edit-dialog__title">{{title}}</view>
    <view class="edit-dialog__body" wx:if="{{mode === 'prompt'}}">
      <input
        class="edit-dialog__input"
        value="{{innerValue}}"
        maxlength="{{maxlength}}"
        placeholder="{{placeholder}}"
        placeholder-class="edit-dialog__ph"
        focus="{{visible}}"
        bindinput="onInput"
        bindconfirm="onConfirm"
        confirm-type="done"
      />
    </view>
    <view class="edit-dialog__body" wx:elif="{{content}}">
      <text class="edit-dialog__content">{{content}}</text>
    </view>
    <view class="edit-dialog__actions">
      <view
        wx:if="{{showCancel}}"
        class="edit-dialog__btn edit-dialog__btn--cancel"
        catchtap="onCancel"
      >{{cancelText}}</view>
      <view
        class="edit-dialog__btn edit-dialog__btn--ok {{danger ? 'edit-dialog__btn--danger' : ''}} {{showCancel ? '' : 'edit-dialog__btn--alone'}}"
        catchtap="onConfirm"
      >{{confirmText}}</view>
    </view>

  </view>
</view>
