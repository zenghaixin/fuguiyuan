<view class="edit-invite">
  <view class="edit-invite__head" style="padding-top: {{backTop}}px;">
    <view class="edit-invite__nav" style="height: {{backSize}}px;">
      <view class="edit-invite__title">编辑喜帖</view>
    </view>
    <view class="edit-invite__sub">{{pages.length ? (activeElementId ? '调整中，点「完成」结束编辑' : '虚线内为安全区，重要内容请放虚线内') : '从模板开始制作喜帖'}}</view>
  </view>

  <view class="edit-invite__body">
    <view class="edit-canvas" wx:if="{{!pages.length}}" bindtap="onPickTemplate">
      <view class="edit-canvas__frame">
        <t-icon name="file" size="64rpx" color="#c4b5a5" />
        <view class="edit-canvas__tip">点击选择喜帖模板</view>
        <view class="edit-canvas__desc">选择模板后可再改背景、字体与文案</view>
      </view>
    </view>

    <view class="stage" wx:else>
      <!-- 背景全铺：不受虚线限制，预览留白也靠它补齐 -->
      <view
        class="stage__bleed"
        style="background: {{pages[pageIndex].bgColor || '#f7f0ea'}};"
      >
        <image
          wx:if="{{pages[pageIndex].bgSrc}}"
          class="stage__bleed-img"
          src="{{pages[pageIndex].bgSrc}}"
          mode="aspectFill"
        />
      </view>

      <view class="stage__frost" style="{{frostStyle}}" />

      <view class="stage__safe" style="{{safeStyle}}">
        <view
          class="stage__page"
          catchtouchstart="onPageTouchStart"
          catchtouchmove="onPageTouchMove"
          catchtouchend="onPageTouchEnd"
          catchtouchcancel="onPageTouchEnd"
          catchtap="onPageTap"
        >
          <view class="stage__clip">
            <edit-transform
              wx:for="{{pages[pageIndex].elements}}"
              wx:key="id"
              el-id="{{item.id}}"
              x="{{item.x}}"
              y="{{item.y}}"
              w="{{item.w}}"
              h="{{item.h}}"
              rotate="{{item.rotate}}"
              selected="{{activeElementId === item.id}}"
              edit-mode="{{activeElementId === item.id ? elementEditMode : 'position'}}"
              locked="{{!!activeElementId}}"
              z-index="{{activeElementId === item.id ? (item.layer || 1) + 10000 : (item.layer || 1)}}"
              canvas-width="{{canvasWidth}}"
              canvas-height="{{canvasHeight}}"
              canvas-left="{{canvasLeft}}"
              canvas-top="{{canvasTop}}"
              bind:select="onSelectElement"
              bind:change="onElementChange"
            >
              <view class="stage__el-body" style="background: {{item.color}};">
                <text class="stage__el-label" wx:if="{{item.label}}">{{item.label}}</text>
              </view>
            </edit-transform>
          </view>
        </view>
        <view class="stage__frame" />
      </view>
    </view>
  </view>
</view>
