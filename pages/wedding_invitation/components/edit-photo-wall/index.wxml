<view class="edit-photo">
  <view class="edit-photo__head" style="padding-top: {{backTop}}px;">
    <view class="edit-photo__nav" style="height: {{backSize}}px;">
      <view class="edit-photo__title">编辑照片墙</view>
    </view>
    <view class="edit-photo__sub">{{subText}}</view>
  </view>

  <view class="edit-photo__body">
    <view class="edit-photo__stage">
      <!-- 非宫格/杂志且无图：点击添加 -->
      <view class="edit-canvas" wx:if="{{!photos.length && !isGrid && !isMagazine}}" bindtap="onAdd">
        <view class="edit-canvas__frame">
          <t-icon name="image" size="64rpx" color="#c4b5a5" />
          <view class="edit-canvas__tip">点击添加照片</view>
          <view class="edit-canvas__desc">可多选，默认左右滑动浏览</view>
        </view>
      </view>

      <!-- 网格族：四/九/杂志共用 pw-magazine；旧 pw-grid 暂保留未删 -->
      <pw-magazine
        wx:elif="{{isGrid || isMagazine}}"
        id="magLayout"
        photos="{{photos}}"
        height="{{stageHeight}}"
        layout="{{layout}}"
        editable="{{true}}"
        bind:delete="onDelete"
        bind:preview="onPreview"
        bind:framesensure="onFramesEnsure"
        bind:framechange="onFrameChange"
        bind:coverfocus="onCoverFocus"
        bind:select="onSelect"
      />

      <pw-column
        wx:elif="{{layout === 'column'}}"
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{true}}"
        bind:delete="onDelete"
        bind:change="onChange"
        bind:preview="onPreview"
      />
      <pw-fade
        wx:elif="{{layout === 'fade'}}"
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{true}}"
        bind:delete="onDelete"
        bind:change="onChange"
        bind:preview="onPreview"
      />
      <pw-thumbs
        wx:elif="{{layout === 'thumbs'}}"
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{true}}"
        bind:delete="onDelete"
        bind:change="onChange"
        bind:preview="onPreview"
      />
      <pw-stack
        wx:elif="{{layout === 'stack'}}"
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{true}}"
        bind:delete="onDelete"
        bind:change="onChange"
        bind:preview="onPreview"
      />
      <pw-carousel
        wx:else
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{true}}"
        bind:delete="onDelete"
        bind:change="onChange"
        bind:preview="onPreview"
      />
    </view>

    <view class="edit-photo__add" wx:if="{{photos.length || isGrid || isMagazine}}" bindtap="onAdd">
      <t-icon name="add" size="36rpx" color="#b91c3a" />
      <text>{{photos.length ? '继续添加照片' : '添加照片'}}</text>
    </view>
  </view>
</view>
