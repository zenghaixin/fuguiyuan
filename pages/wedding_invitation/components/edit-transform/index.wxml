<view
  class="tf {{selected ? 'tf--on' : ''}}"
  style="left: {{dx * 100}}%; top: {{dy * 100}}%; width: {{dw * 100}}%; height: {{dh * 100}}%; z-index: {{zIndex}}; pointer-events: {{locked && !selected ? 'none' : 'auto'}};"
>
  <!-- 内容 + 选框/手柄：一起跟随角度旋转 -->
  <view
    class="tf__spin"
    style="transform: rotate({{drotate}}deg);"
    catchtouchstart="onBodyStart"
    catchtouchmove="onBodyMove"
    catchtouchend="onBodyEnd"
    catchtouchcancel="onBodyEnd"
  >
    <view class="tf__hit">
      <slot />
    </view>

    <block wx:if="{{selected}}">
      <view class="tf__frame" />

      <!-- 四角：拖动手柄改大小 -->
      <view
        class="tf__handle tf__handle--nw"
        data-corner="nw"
        catchtouchstart="onResizeStart"
        catchtouchmove="onResizeMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />
      <view
        class="tf__handle tf__handle--ne"
        data-corner="ne"
        catchtouchstart="onResizeStart"
        catchtouchmove="onResizeMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />
      <view
        class="tf__handle tf__handle--sw"
        data-corner="sw"
        catchtouchstart="onResizeStart"
        catchtouchmove="onResizeMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />
      <view
        class="tf__handle tf__handle--se"
        data-corner="se"
        catchtouchstart="onResizeStart"
        catchtouchmove="onResizeMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />

      <!-- 四角外侧半圆：拖动改角度 -->
      <view
        class="tf__rot tf__rot--nw"
        catchtouchstart="onRotateStart"
        catchtouchmove="onRotateMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />
      <view
        class="tf__rot tf__rot--ne"
        catchtouchstart="onRotateStart"
        catchtouchmove="onRotateMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />
      <view
        class="tf__rot tf__rot--sw"
        catchtouchstart="onRotateStart"
        catchtouchmove="onRotateMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />
      <view
        class="tf__rot tf__rot--se"
        catchtouchstart="onRotateStart"
        catchtouchmove="onRotateMove"
        catchtouchend="onGestureEnd"
        catchtouchcancel="onGestureEnd"
      />
    </block>
  </view>

  <!-- 角度读数放在旋转层外，保持正向不跟着转 -->
  <view class="tf__angle-hud" wx:if="{{selected && angleHudVisible}}">
    <text>{{angleText}}</text>
  </view>
</view>
