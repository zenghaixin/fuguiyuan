<wxs src="../../utils/element-style.wxs" module="elStyle" />
<view
  class="invite-cover {{fullBleed ? 'invite-cover--bleed' : ''}}"
  style="height: {{windowHeight}}px; background: {{coverBg}};"
  catchtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  catchtouchend="onTouchEnd"
  catchtouchcancel="onTouchEnd"
>
  <view
    class="invite-cover__track {{animating ? 'invite-cover__track--anim' : ''}}"
    style="height: {{trackHeight}}px; transform: translate3d(0, {{translateY}}px, 0);"
  >
    <view
      class="invite-cover__page"
      wx:for="{{pages}}"
      wx:key="id"
      wx:for-index="idx"
      style="height: {{windowHeight}}px;"
    >
      <view
        class="invite-cover__bleed"
        style="inset: {{bleedInset}}px; background: {{item.bgColor || '#f7f0ea'}};"
      >
        <image
          wx:if="{{item.bgSrc || item.src}}"
          class="invite-cover__bleed-img"
          src="{{item.bgSrc || item.src}}"
          mode="aspectFill"
        />
      </view>

      <view
        class="invite-cover__board"
        style="width: {{frameW}}px; height: {{frameH}}px; left: {{frameL}}px; top: {{frameT}}px;"
      >
        <view
          class="invite-cover__el {{el.type === 'text' ? 'invite-cover__el--text' : ''}} {{elStyle.hasContent(el) ? 'invite-cover__el--plain' : ''}} invite-cover__el--{{el.fontFamily || 'sans'}}"
          wx:for="{{item.elements}}"
          wx:for-item="el"
          wx:key="id"
          style="left: {{el.x * 100}}%; top: {{el.y * 100}}%; width: {{el.w * 100}}%; height: {{el.h * 100}}%; z-index: {{el.layer || 1}}; transform: rotate({{el.rotate || 0}}deg); background: {{elStyle.boxBg(el)}}; color: {{elStyle.boxColor(el)}}; font-size: {{elStyle.fontSizeOnCanvas(el, frameW)}}; font-weight: {{elStyle.fontWeightCss(el)}};{{elStyle.isText(el) ? elStyle.textLayoutStyle(el) : ''}}"
        >
          <text
            wx:if="{{el.type === 'text'}}"
            class="invite-cover__el-text"
            style="{{elStyle.textInnerStyle(el)}}"
          >{{el.text || ''}}</text>
          <text class="invite-cover__el-text" wx:elif="{{el.label}}">{{el.label}}</text>
        </view>
      </view>

      <view
        class="invite-cover__hint {{pageHints[idx].back ? 'invite-cover__hint--back' : ''}}"
        wx:if="{{pageHints[idx]}}"
      >
        <t-icon
          wx:if="{{pageHints[idx].back}}"
          name="chevron-up"
          size="36rpx"
          color="rgba(255,255,255,0.9)"
        />
        <text>{{pageHints[idx].text}}</text>
        <t-icon
          wx:if="{{!pageHints[idx].back}}"
          name="chevron-down"
          size="36rpx"
          color="rgba(255,255,255,0.9)"
        />
      </view>
    </view>
  </view>
</view>
