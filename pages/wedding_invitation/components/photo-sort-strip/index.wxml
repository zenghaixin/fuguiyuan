<view class="sort-grid {{dragging ? 'sort-grid--drag' : ''}}">
  <scroll-view
    class="sort-grid__scroll"
    scroll-y="{{!dragging}}"
    enhanced
    show-scrollbar="{{false}}"
    style="height: {{height}}px;"
  >
    <view class="sort-grid__list sort-grid__list--cols{{cols}}">
      <view
        class="sort-grid__item {{dragFrom === index ? 'sort-grid__item--lift' : ''}} {{hoverIndex === index ? 'sort-grid__item--hover' : ''}} {{activeIndex === index ? 'sort-grid__item--on' : ''}}"

        wx:for="{{photos}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onTap"
        bindlongpress="onLongPress"
        bindtouchmove="onItemTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      >
        <image class="sort-grid__img" src="{{item.src}}" mode="aspectFill" />
        <view class="sort-grid__num">{{index + 1}}</view>
      </view>
    </view>
  </scroll-view>

  <view
    wx:if="{{dragging}}"
    class="sort-grid__ghost"
    style="left: {{ghostX}}px; top: {{ghostY}}px;"
  >
    <image class="sort-grid__ghost-img" src="{{ghostSrc}}" mode="aspectFill" />
  </view>
</view>
