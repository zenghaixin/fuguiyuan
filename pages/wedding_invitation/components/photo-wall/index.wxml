<view
  class="photo-wall"
  style="height: {{windowHeight}}px;"
  catchtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  catchtouchend="onTouchEnd"
  catchtouchcancel="onTouchEnd"
>
  <view class="photo-wall__head" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="photo-wall__title">我们的照片</view>
    <view class="photo-wall__sub">左右滑动查看</view>
  </view>

  <view class="photo-wall__stage">
    <view
      class="photo-wall__track {{animating ? 'photo-wall__track--anim' : ''}}"
      style="width: {{trackWidth}}px; transform: translate3d({{translateX}}px, 0, 0);"
    >
      <view
        class="photo-wall__item"
        wx:for="{{photos}}"
        wx:key="id"
        style="width: {{windowWidth}}px;"
      >
        <view class="photo-wall__frame">
          <image class="photo-wall__img" src="{{item.src}}" mode="aspectFill" />
        </view>
      </view>
    </view>
  </view>

  <view class="photo-wall__footer">
    <view class="photo-wall__caption" wx:if="{{currentCaption}}">{{currentCaption}}</view>
    <view class="photo-wall__dots" wx:if="{{photos.length > 1}}">
      <view
        class="photo-wall__dot {{current === index ? 'photo-wall__dot--on' : ''}}"
        wx:for="{{photos}}"
        wx:key="id"
        wx:for-index="index"
      />
    </view>
    <view class="photo-wall__hint {{hintBack ? 'photo-wall__hint--back' : ''}}">
      <t-icon
        wx:if="{{hintBack}}"
        name="chevron-up"
        size="32rpx"
        color="rgba(243,234,210,0.9)"
      />
      <text>{{hintText}}</text>
      <t-icon
        wx:if="{{!hintBack}}"
        name="chevron-down"
        size="32rpx"
        color="rgba(243,234,210,0.9)"
      />
    </view>
  </view>
</view>
