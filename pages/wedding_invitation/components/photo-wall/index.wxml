<view class="photo-wall" style="height: {{windowHeight}}px;">
  <view
    class="photo-wall__head"
    style="padding-top: {{statusBarHeight + 12}}px;"
    catchtouchstart="onModuleTouchStart"
    catchtouchmove="onModuleTouchMove"
    catchtouchend="onModuleTouchEnd"
    catchtouchcancel="onModuleTouchEnd"
  >
    <view class="photo-wall__title">我们的照片</view>
    <view class="photo-wall__sub">{{subText}}</view>
  </view>


  <view class="photo-wall__stage">
    <!-- 网格族（四/九宫格 + 杂志）：同一套杂志引擎；旧 pw-grid 暂保留未删 -->
    <view
      wx:if="{{isGrid || isMagazine}}"
      class="photo-wall__grid-wrap"
      style="height: {{stageHeight}}px;"
      bindtouchstart="onModuleTouchStart"
      bindtouchmove="onModuleTouchMove"
      bindtouchend="onModuleTouchEnd"
      bindtouchcancel="onModuleTouchEnd"
    >
      <pw-magazine
        photos="{{photos}}"
        height="{{stageHeight}}"
        layout="{{layout}}"
        editable="{{false}}"
        has-next-module="{{hasNextModule}}"
        bind:preview="onGridPreview"
        bind:moduledrag="onStackModuleDrag"
      />
    </view>

    <!-- 叠放：组件内左右翻牌，纵向 moduledrag 切模块 -->
    <view
      wx:elif="{{isStack}}"
      class="photo-wall__grid-wrap"
      style="height: {{stageHeight}}px;"
    >
      <pw-stack
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{false}}"
        has-next-module="{{hasNextModule}}"
        bind:preview="onStackPreview"
        bind:change="onStackChange"
        bind:moduledrag="onStackModuleDrag"
      />
    </view>

    <!-- 淡入淡出：左右切图，纵向切模块 -->
    <view
      wx:elif="{{isFade}}"
      class="photo-wall__grid-wrap"
      style="height: {{stageHeight}}px;"
    >
      <pw-fade
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{false}}"
        has-next-module="{{hasNextModule}}"
        bind:preview="onStackPreview"
        bind:change="onStackChange"
        bind:moduledrag="onStackModuleDrag"
      />
    </view>

    <!-- 缩略导览：大图 + 底部缩略条 -->
    <view
      wx:elif="{{isThumbs}}"
      class="photo-wall__grid-wrap"
      style="height: {{stageHeight}}px;"
    >
      <pw-thumbs
        photos="{{photos}}"
        height="{{stageHeight}}"
        current="{{current}}"
        editable="{{false}}"
        has-next-module="{{hasNextModule}}"
        bind:preview="onStackPreview"
        bind:change="onStackChange"
        bind:moduledrag="onStackModuleDrag"
      />
    </view>

    <!-- 上下 / 左右：整区手势 -->
    <view
      wx:else
      class="photo-wall__swipe"
      catchtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      catchtouchend="onTouchEnd"
      catchtouchcancel="onTouchEnd"
    >
      <view
        wx:if="{{layout === 'column'}}"
        class="photo-wall__track photo-wall__track--column {{animating ? 'photo-wall__track--anim' : ''}}"
        style="height: {{trackHeight}}px; transform: translate3d(0, {{translateY}}px, 0);"
      >
        <view
          class="photo-wall__item photo-wall__item--column"
          wx:for="{{viewPhotos}}"
          wx:key="id"
          style="height: {{stageHeight}}px;"
        >
          <view class="photo-wall__frame">
            <image
              wx:if="{{item.useCrop}}"
              class="photo-wall__img photo-wall__img--crop"
              src="{{item.src}}"
              mode="scaleToFill"
              style="{{item.imgBoxStyle}}"
            />
            <image
              wx:else
              class="photo-wall__img photo-wall__img--fit"
              src="{{item.src}}"
              mode="aspectFill"
            />
          </view>
        </view>
      </view>
      <view
        wx:else
        class="photo-wall__track {{animating ? 'photo-wall__track--anim' : ''}}"
        style="width: {{trackWidth}}px; transform: translate3d({{translateX}}px, 0, 0);"
      >
        <view
          class="photo-wall__item"
          wx:for="{{viewPhotos}}"
          wx:key="id"
          style="width: {{windowWidth}}px;"
        >
          <view class="photo-wall__frame">
            <image
              wx:if="{{item.useCrop}}"
              class="photo-wall__img photo-wall__img--crop"
              src="{{item.src}}"
              mode="scaleToFill"
              style="{{item.imgBoxStyle}}"
            />
            <image
              wx:else
              class="photo-wall__img photo-wall__img--fit"
              src="{{item.src}}"
              mode="aspectFill"
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    class="photo-wall__footer {{footerSlim ? 'photo-wall__footer--slim' : ''}}"
    catchtouchstart="onModuleTouchStart"
    catchtouchmove="onModuleTouchMove"
    catchtouchend="onModuleTouchEnd"
    catchtouchcancel="onModuleTouchEnd"
  >
    <view class="photo-wall__caption" wx:if="{{currentCaption && !isGrid && !isMagazine && !isStack && !isFade && !isThumbs}}">{{currentCaption}}</view>
    <view class="photo-wall__dots" wx:if="{{photos.length > 1 && !isGrid && !isMagazine && !isStack && !isFade && !isThumbs}}">
      <view
        class="photo-wall__dot {{current === index ? 'photo-wall__dot--on' : ''}}"
        wx:for="{{photos}}"
        wx:key="id"
        wx:for-index="index"
      />
    </view>

    <!-- 无下一部分时不占位，避免宫格下方空出一条 -->
    <view
      wx:if="{{hintVisible}}"
      class="photo-wall__hint {{hintBack ? 'photo-wall__hint--back' : ''}}"
    >
      <t-icon
        wx:if="{{hintBack}}"
        name="chevron-up"
        size="32rpx"
        color="rgba(243,234,210,0.9)"
      />
      <text>{{hintText}}</text>
      <t-icon
        wx:if="{{!hintBack}}"
        name="chevron-down"
        size="32rpx"
        color="rgba(243,234,210,0.9)"
      />
    </view>
  </view>

</view>

