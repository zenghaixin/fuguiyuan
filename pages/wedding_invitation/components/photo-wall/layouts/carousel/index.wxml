<view class="pw-carousel" style="height: {{height}}px;">
  <swiper
    class="pw-carousel__swiper"
    style="height: {{height}}px;"
    current="{{innerCurrent}}"
    bindchange="onChange"

    circular="{{false}}"
    duration="{{280}}"
  >
    <swiper-item wx:for="{{photos}}" wx:key="id">
      <view class="pw-carousel__slide" data-index="{{index}}" bindtap="onPreview">
        <view class="pw-carousel__frame">
          <image class="pw-carousel__img" src="{{item.src}}" mode="aspectFit" />
          <view
            wx:if="{{editable}}"
            class="pw-carousel__del"
            data-id="{{item.id}}"
            catchtap="onDelete"
          >
            <t-icon name="close" size="28rpx" color="#fff" />
          </view>
        </view>
        <view class="pw-carousel__caption" wx:if="{{item.caption}}">{{item.caption}}</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="pw-carousel__dots" wx:if="{{photos.length > 1}}">
    <view
      class="pw-carousel__dot {{current === index ? 'pw-carousel__dot--on' : ''}}"
      wx:for="{{photos}}"
      wx:key="id"
      wx:for-index="index"
    />
  </view>
</view>
