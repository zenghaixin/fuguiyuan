<view class="pw-stack" style="height: {{height}}px;">
  <view wx:if="{{!deck.length}}" class="pw-stack__empty">
    <t-icon name="image" size="64rpx" color="rgba(243,234,210,0.45)" />
    <text>暂无照片</text>
  </view>

  <view wx:else class="pw-stack__deck">
    <view class="pw-stack__count" wx:if="{{totalCount > 1}}">{{countText}}</view>

    <!--
      环形预留牌位（A,B,C,D,A…）：wx:key 用绝对下标，飞走卸顶层，底下已预载不会突兀冒出。
      顶牌跟手 topStyle；飞走 flyGhost；透明 button 负责 tap 看大图。
    -->
    <view
      wx:for="{{deck}}"
      wx:key="id"
      class="pw-stack__card {{item.isTop ? 'pw-stack__card--top' : 'pw-stack__card--behind'}} {{rising ? 'pw-stack__card--rise' : ''}}"
      style="{{item.isTop && topStyle ? topStyle : item.layerStyle}}"
    >
      <view class="pw-stack__img-wrap">
        <image
          wx:if="{{item.useCrop}}"
          class="pw-stack__img pw-stack__img--crop"
          src="{{item.src}}"
          mode="scaleToFill"
          style="{{item.imgBoxStyle}}"
        />
        <image
          wx:else
          class="pw-stack__img pw-stack__img--fit"
          src="{{item.src}}"
          mode="aspectFill"
        />
      </view>
      <view class="pw-stack__caption" wx:if="{{item.caption && item.isTop}}">{{item.caption}}</view>
    </view>

    <view
      wx:if="{{flyGhost.show}}"
      class="pw-stack__card pw-stack__card--ghost"
      style="{{flyGhost.style}}"
    >
      <view class="pw-stack__img-wrap">
        <image
          wx:if="{{flyGhost.useCrop}}"
          class="pw-stack__img pw-stack__img--crop"
          src="{{flyGhost.src}}"
          mode="scaleToFill"
          style="{{flyGhost.imgBoxStyle}}"
        />
        <image
          wx:else
          class="pw-stack__img pw-stack__img--fit"
          src="{{flyGhost.src}}"
          mode="aspectFill"
        />
      </view>
    </view>

    <!--
      原生 button 会盖住普通 view（z-index 无效），删钮必须放在 button 内部，
      用 catchtap 拦截，才点得动且不误触看大图。
    -->
    <button
      class="pw-stack__hit"
      hover-class="none"
      bindtap="onTap"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    >
      <view
        wx:if="{{editable && topId}}"
        class="pw-stack__delhost"
        style="{{topStyle || topLayerStyle}}"
      >
        <!-- 不用 t-icon：自定义组件嵌在原生 button 内，删图重建时易 FLOW_ALLOC_NODE_ID -->
        <view
          class="pw-stack__del"
          data-id="{{topId}}"
          catchtouchstart="onDeleteStart"
          catchtouchend="onDelete"
          catchtouchcancel="onDeleteCancel"
          catchtap="onDelete"
        >
          <text class="pw-stack__del-x">×</text>
        </view>
      </view>
    </button>
  </view>
</view>
