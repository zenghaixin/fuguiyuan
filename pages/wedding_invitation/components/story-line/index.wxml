<wxs src="../../utils/element-style.wxs" module="elStyle" />
<view
  class="story-wall"
  style="height: {{windowHeight}}px;"
  catchtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  catchtouchend="onTouchEnd"
  catchtouchcancel="onTouchEnd"
>
  <view
    class="story-wall__head"
    style="padding-top: {{statusBarHeight + 12}}px;"
  >
    <view class="story-wall__title">我们的故事</view>
    <view class="story-wall__sub" wx:if="{{pageText}}">{{pageText}}</view>
  </view>

  <view class="story-wall__viewport">
    <view
      class="story-wall__track {{animating ? 'story-wall__track--anim' : ''}}"
      style="height: {{trackHeight}}px; transform: translate3d(0, {{translateY}}px, 0);"
    >
      <view
        class="story-block story-block--{{item.type}} {{index === current ? 'story-block--on' : ''}}"
        wx:for="{{list}}"
        wx:key="id"
        style="height: {{windowHeight}}px;"
      >
        <!-- 图片块 -->
        <view class="story-block__inner story-block__inner--photo" wx:if="{{item.type === 'photo'}}">
          <image
            wx:if="{{item.photo.src}}"
            class="story-block__img"
            src="{{item.photo.src}}"
            mode="aspectFill"
          />
          <view class="story-block__empty" wx:else>暂无照片</view>
        </view>

        <!-- 文案块：喜帖同款画布 -->
        <view
          class="story-block__inner story-block__inner--text"
          wx:else
          style="background: {{item.bgColor || '#f7f0ea'}};"
        >
          <image
            wx:if="{{item.bgSrc}}"
            class="story-block__img"
            src="{{item.bgSrc}}"
            mode="aspectFill"
          />
          <view
            class="story-block__el {{el.type === 'text' ? 'story-block__el--text' : ''}} {{elStyle.hasContent(el) ? 'story-block__el--plain' : ''}}"
            wx:for="{{item.elements}}"
            wx:for-item="el"
            wx:key="id"
            style="left: {{el.x * 100}}%; top: {{el.y * 100}}%; width: {{el.w * 100}}%; height: {{el.h * 100}}%; z-index: {{el.layer || 1}}; transform: rotate({{el.rotate || 0}}deg); background: {{elStyle.boxBg(el)}}; color: {{elStyle.boxColor(el)}}; font-size: {{elStyle.fontSize(el)}}; font-weight: {{elStyle.fontWeightCss(el)}};{{elStyle.isText(el) ? elStyle.textLayoutStyle(el) : ''}}"
          >
            <block wx:if="{{el.type === 'text'}}">
              <!-- 滑动出字：与底部进度条绑定 -->
              <view
                wx:if="{{el.scrubLines}}"
                class="story-scrub story-block__el-text"
                style="{{elStyle.textInnerStyle(el)}}"
              >
                <view
                  class="story-scrub__line {{line.on ? 'story-scrub__line--on' : ''}}"
                  wx:for="{{el.scrubLines}}"
                  wx:for-item="line"
                  wx:for-index="li"
                  wx:key="li"
                >{{line.text}}</view>
              </view>
              <view
                wx:elif="{{index === current && elStyle.hasTextAnim(el)}}"
                class="text-anim story-block__el-text"
                style="{{elStyle.textInnerStyle(el)}}"
              >
                <block wx:for="{{elStyle.textChars(el)}}" wx:for-item="ch" wx:key="i">
                  <view wx:if="{{ch.nl}}" class="text-anim__br" />
                  <text
                    wx:else
                    class="text-anim__char text-anim__char--{{el.textAnim}}"
                    style="{{elStyle.animDelay(ch.i, 70)}}"
                  >{{ch.t}}</text>
                </block>
              </view>
              <text
                wx:else
                class="story-block__el-text"
                style="{{elStyle.textInnerStyle(el)}}"
              >{{el.text || ''}}</text>
            </block>
            <text class="story-block__el-text" wx:elif="{{el.label}}">{{el.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="story-wall__hint" wx:if="{{hintText}}">
    <t-icon
      wx:if="{{hintBack}}"
      name="chevron-down"
      size="28rpx"
      color="rgba(243,234,210,0.85)"
    />
    <t-icon
      wx:else
      name="chevron-up"
      size="28rpx"
      color="rgba(243,234,210,0.85)"
    />
    <text>{{hintText}}</text>
  </view>

  <!-- 故事线默认进度条：驱动 scrubLine 文字 -->
  <view class="story-wall__bar">
    <view class="story-wall__bar-fill" style="width: {{scrubProgress * 100}}%;" />
  </view>
</view>
