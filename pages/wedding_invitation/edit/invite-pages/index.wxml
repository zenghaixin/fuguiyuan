<wxs src="../../utils/element-style.wxs" module="elStyle" />
<view class="pages-hub">
  <view
    class="pages-hub__back"
    style="top: {{backTop}}px; width: {{backSize}}px; height: {{backSize}}px;"
    catchtap="onBack"
  >
    <t-icon name="chevron-left" size="44rpx" color="#3d2914" />
  </view>

  <view class="pages-hub__head" style="padding-top: {{backTop}}px;">
    <view class="pages-hub__nav" style="height: {{backSize}}px;">
      <view class="pages-hub__title-row" catchtap="onRenameWork">
        <text class="pages-hub__title">{{workTitle}}</text>
        <t-icon name="edit" size="32rpx" color="#8a7464" />
      </view>
    </view>
    <view class="pages-hub__sub">选择模块继续编辑，或预览整份喜帖</view>
  </view>

  <scroll-view class="pages-hub__scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pages-hub__list">
      <view
        class="mod-card"
        wx:for="{{modules}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onOpenModule"
      >
        <!-- 喜帖：优先封面截图，否则实时拼元素 -->
        <view
          wx:if="{{item.key === 'invite' && coverThumbSrc}}"
          class="mod-card__cover"
        >
          <image class="mod-card__bg" src="{{coverThumbSrc}}" mode="aspectFill" />
        </view>
        <view
          wx:elif="{{item.key === 'invite' && coverPage}}"
          class="mod-card__cover"
          style="background: {{coverPage.bgColor || '#f7f0ea'}};"
        >
          <image
            wx:if="{{coverPage.bgSrc}}"
            class="mod-card__bg"
            src="{{coverPage.bgSrc}}"
            mode="aspectFill"
          />
          <view
            wx:for="{{coverPage.elements}}"
            wx:for-item="el"
            wx:key="id"
            class="mod-card__el"
            style="left: {{el.x * 100}}%; top: {{el.y * 100}}%; width: {{el.w * 100}}%; height: {{el.h * 100}}%; background: {{elStyle.boxBg(el)}}; transform: rotate({{el.rotate || 0}}deg); z-index: {{el.layer || 1}}; {{elStyle.isText(el) ? elStyle.textLayoutStyle(el) : ''}}"
          >
            <text
              wx:if="{{elStyle.thumbText(el)}}"
              class="mod-card__el-text"
              style="color: {{elStyle.boxColor(el)}}; font-size: {{elStyle.fontSizeOnCanvas(el, thumbBoardW)}}; font-weight: {{elStyle.fontWeightCss(el)}};{{elStyle.textInnerStyle(el)}}"
            >{{elStyle.thumbText(el)}}</text>
          </view>
        </view>
        <view
          wx:elif="{{item.key === 'invite'}}"
          class="mod-card__cover"
        >
          <t-icon name="mail" size="36rpx" color="#b5a394" />
        </view>

        <!-- 故事线 -->
        <view
          wx:elif="{{item.key === 'story'}}"
          class="mod-card__cover mod-card__cover--story"
        >
          <t-icon name="heart" size="40rpx" color="#b91c3a" />
        </view>

        <!-- 照片墙 -->
        <view
          wx:else
          class="mod-card__cover mod-card__cover--photo"
        >
          <image
            wx:if="{{photoCoverSrc}}"
            class="mod-card__bg"
            src="{{photoCoverSrc}}"
            mode="aspectFill"
          />
          <t-icon
            wx:else
            name="image"
            size="40rpx"
            color="#c4a574"
          />
        </view>

        <view class="mod-card__main">
          <view class="mod-card__name">{{item.name}}</view>
          <view class="mod-card__meta">{{item.meta}}</view>
        </view>
        <view class="mod-card__go">
          <t-icon name="chevron-right" size="40rpx" color="#b5a394" />
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="pages-hub__foot">
    <view class="pages-hub__preview" bindtap="onPreviewAll">预览喜帖</view>
  </view>

  <edit-dialog
    visible="{{dialog.visible}}"
    mode="{{dialog.mode}}"
    title="{{dialog.title}}"
    content="{{dialog.content}}"
    value="{{dialog.value}}"
    placeholder="{{dialog.placeholder}}"
    confirm-text="{{dialog.confirmText}}"
    danger="{{dialog.danger}}"
    bind:cancel="onDialogCancel"
    bind:confirm="onDialogConfirm"
  />
</view>
