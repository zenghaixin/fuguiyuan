<view class="page">
  <view
    class="page-back"
    style="top: {{backTop}}px; width: {{backSize}}px; height: {{backSize}}px;"
    catchtap="onBack"
  >
    <t-icon name="chevron-left" size="44rpx" color="#3d2914" />
  </view>

  <edit-invite
    pages="{{invitePages}}"
    page-index="{{invitePageIndex}}"
    active-element-id="{{activeElementId}}"
    element-edit-mode="{{elementEditMode}}"
    window-height="{{windowHeight}}"
    window-width="{{windowWidth}}"
    status-bar-height="{{statusBarHeight}}"
    back-top="{{backTop}}"
    back-size="{{backSize}}"
    bind:picktemplate="onPickTemplate"
    bind:selectelement="onSelectElement"
    bind:elementchange="onElementChange"
  />

  <edit-toolbox
    tools="{{toolboxTools}}"
    active-key="{{toolboxActive}}"
    bind:select="onToolboxSelect"
  />

  <edit-decor-sheet
    visible="{{decorSheetVisible}}"
    assets="{{decorAssets}}"
    title="选择修饰"
    hint="色块为占位素材，选中后放到内容区正中"
    bind:close="closeDecorSheet"
    bind:select="onDecorSelect"
  />

  <edit-decor-sheet
    visible="{{bgSheetVisible}}"
    assets="{{bgAssets}}"
    title="选择背景"
    hint="浅色占位；背景全屏铺开，不受虚线限制"
    bind:close="closeBgSheet"
    bind:select="onBgSelect"
  />

  <edit-layer-panel
    visible="{{layerPanelVisible}}"
    layers="{{layerList}}"
    active-id="{{activeElementId}}"
    bind:close="closeLayerPanel"
    bind:select="onLayerSelect"
    bind:editlayer="onLayerEdit"
  />

  <edit-layer-picker
    visible="{{layerPickerVisible}}"
    value="{{layerPickerValue}}"
    bind:close="closeLayerPicker"
    bind:select="onLayerPick"
  />
</view>
