<view class="page">
  <view
    class="page-back"
    style="top: {{backTop}}px; width: {{backSize}}px; height: {{backSize}}px;"
    catchtap="onBack"
  >
    <t-icon name="chevron-left" size="44rpx" color="#3d2914" />
  </view>

  <view class="page-head" style="padding-top: {{backTop}}px;">
    <view class="page-head__nav" style="height: {{backSize}}px;">
      <view class="page-head__title">故事线</view>
    </view>
    <view class="page-head__sub">
      {{chapters.length ? ('第 ' + (current + 1) + ' / ' + chapters.length + ' 章 · 左右滑动切换') : '添加章节，讲述你们的故事'}}
    </view>
  </view>

  <view class="page-body">
    <view class="stage" style="height: {{stageHeight}}px;" wx:if="{{chapters.length}}">
      <swiper
        class="stage__swiper"
        style="height: {{stageHeight}}px;"
        current="{{current}}"
        bindchange="onSwiperChange"
        duration="280"
      >
        <swiper-item wx:for="{{chapters}}" wx:key="id">
          <view class="chapter chapter--{{item.layout}}">
            <block wx:if="{{item.layout === 'text'}}">
              <view
                class="chapter__bg"
                style="background: {{item.bgColor || '#f7f0ea'}};"
              />
              <view class="chapter__text chapter__text--solo">
                <view class="chapter__date" wx:if="{{item.date}}">{{item.date}}</view>
                <view class="chapter__name">{{item.title || '未命名'}}</view>
                <view class="chapter__body" wx:if="{{item.body}}">{{item.body}}</view>
              </view>
            </block>
            <block wx:elif="{{item.layout === 'photo'}}">
              <image
                wx:if="{{item.photo.src}}"
                class="chapter__full"
                src="{{item.photo.src}}"
                mode="aspectFill"
              />
              <view class="chapter__empty" wx:else>点「换图」添加照片</view>
            </block>
            <block wx:else>
              <view class="chapter__media">
                <image
                  wx:if="{{item.photo.src}}"
                  class="chapter__img"
                  src="{{item.photo.src}}"
                  mode="aspectFill"
                />
                <view class="chapter__empty" wx:else>点「换图」添加照片</view>
              </view>
              <view class="chapter__text">
                <view class="chapter__date" wx:if="{{item.date}}">{{item.date}}</view>
                <view class="chapter__name">{{item.title || '未命名'}}</view>
                <view class="chapter__body" wx:if="{{item.body}}">{{item.body}}</view>
              </view>
            </block>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="empty" style="height: {{stageHeight}}px;" wx:else>
      <view class="empty__icon">
        <t-icon name="heart" size="56rpx" color="#b91c3a" />
      </view>
      <view class="empty__tip">还没有章节</view>
      <view class="empty__desc">点下方「添加」开始第一段故事</view>
    </view>
  </view>

  <edit-toolbox
    tools="{{toolboxTools}}"
    active-key="{{toolboxActive}}"
    bind:select="onToolboxSelect"
  />

  <!-- 版式 -->
  <view class="sheet" wx:if="{{layoutVisible}}" catchtouchmove="noop">
    <view class="sheet__mask" catchtap="closeLayoutSheet" />
    <view class="sheet__panel">
      <view class="sheet__bar" />
      <view class="sheet__title">选择版式</view>
      <view class="sheet__opts">
        <view
          class="sheet__opt {{currentChapter.layout === item.key ? 'sheet__opt--on' : ''}}"
          wx:for="{{layoutOptions}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onPickLayout"
        >
          <view class="sheet__opt-name">{{item.label}}</view>
          <view class="sheet__opt-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 文案 -->
  <view class="sheet" wx:if="{{textVisible}}" catchtouchmove="noop">
    <view class="sheet__mask" catchtap="closeTextSheet" />
    <view class="sheet__panel sheet__panel--form">
      <view class="sheet__bar" />
      <view class="sheet__head">
        <view class="sheet__title">编辑文案</view>
        <view class="sheet__done" catchtap="confirmTextSheet">完成</view>
      </view>
      <view class="form">
        <view class="form__label">标题</view>
        <input
          class="form__input"
          value="{{textDraft.title}}"
          data-field="title"
          bindinput="onTextInput"
          maxlength="20"
          placeholder="章节标题"
        />
        <view class="form__label">日期</view>
        <input
          class="form__input"
          value="{{textDraft.date}}"
          data-field="date"
          bindinput="onTextInput"
          maxlength="20"
          placeholder="如 2019.05.20"
        />
        <view class="form__label">正文</view>
        <textarea
          class="form__area"
          value="{{textDraft.body}}"
          data-field="body"
          bindinput="onTextInput"
          maxlength="200"
          placeholder="写下这一段故事…"
        />
      </view>
    </view>
  </view>

  <!-- 背景色 -->
  <view class="sheet" wx:if="{{bgVisible}}" catchtouchmove="noop">
    <view class="sheet__mask" catchtap="closeBgSheet" />
    <view class="sheet__panel">
      <view class="sheet__bar" />
      <view class="sheet__title">背景颜色</view>
      <view class="bg-grid">
        <view
          class="bg-grid__item {{currentChapter.bgColor === item.color ? 'bg-grid__item--on' : ''}}"
          wx:for="{{bgAssets}}"
          wx:key="id"
          style="background: {{item.color}};"
          data-color="{{item.color}}"
          bindtap="onBgSelect"
        >
          <text class="bg-grid__label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 排序 -->
  <view class="sheet" wx:if="{{sortVisible}}" catchtouchmove="noop">
    <view class="sheet__mask" catchtap="closeSortSheet" />
    <view class="sheet__panel sheet__panel--form">
      <view class="sheet__bar" />
      <view class="sheet__head">
        <view class="sheet__title">调整顺序</view>
        <view class="sheet__done" catchtap="confirmSortSheet">完成</view>
      </view>
      <scroll-view class="sort-list" scroll-y>
        <view
          class="sort-row"
          wx:for="{{sortDraft}}"
          wx:key="id"
        >
          <view class="sort-row__main">
            <view class="sort-row__name">{{item.title || '未命名'}}</view>
            <view class="sort-row__meta">{{item.date || item.layout}}</view>
          </view>
          <view class="sort-row__actions">
            <view
              class="sort-row__btn"
              data-index="{{index}}"
              catchtap="onSortMoveUp"
            >上移</view>
            <view
              class="sort-row__btn"
              data-index="{{index}}"
              catchtap="onSortMoveDown"
            >下移</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <edit-dialog
    visible="{{alertDialog.visible}}"
    mode="confirm"
    title="{{alertDialog.title}}"
    content="{{alertDialog.content}}"
    confirm-text="{{alertDialog.confirmText}}"
    show-cancel="{{false}}"
    bind:cancel="onAlertClose"
    bind:confirm="onAlertClose"
  />
</view>
