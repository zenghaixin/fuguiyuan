<view class="page">
  <view
    class="page-back"
    style="top: {{backTop}}px; width: {{backSize}}px; height: {{backSize}}px;"
    catchtap="onBack"
  >
    <t-icon name="chevron-left" size="44rpx" color="#fff" />
  </view>

  <view
    class="module-slider {{moduleAnimating ? 'module-slider--anim' : ''}}"
    style="height: {{moduleTrackHeight}}px; transform: translate3d(0, {{moduleTranslateY}}px, 0);"
  >
    <!-- ① 请柬封面 -->
    <invite-cover
      wx:if="{{showCover}}"
      pages="{{invitePages}}"
      window-height="{{windowHeight}}"
      window-width="{{windowWidth}}"
      active="{{moduleIndex === 0}}"
      left-behind="{{moduleIndex > 0}}"
      has-next-module="{{hasNextAfterCover}}"
      start-page-index="{{coverStartPage}}"
      full-bleed="{{!enableSafeGuide}}"
      bind:moduledrag="onModuleDrag"
    />

    <!-- ② 故事线：有章节才显示 -->
    <story-line
      wx:if="{{showStory}}"
      blocks="{{storyBlocks}}"
      window-height="{{windowHeight}}"
      window-width="{{windowWidth}}"
      status-bar-height="{{statusBarHeight}}"
      active="{{moduleIndex === storyModuleIndex}}"
      left-behind="{{moduleIndex > storyModuleIndex}}"
      has-next-module="{{hasNextAfterStory}}"
      start-index="{{storyStartIndex}}"
      bind:moduledrag="onModuleDrag"
    />

    <!-- ③ 照片墙：有数据才显示 -->
    <photo-wall
      wx:if="{{showPhotoWall}}"
      id="photoWall"
      photos="{{photoWall}}"
      window-height="{{windowHeight}}"
      window-width="{{windowWidth}}"
      status-bar-height="{{statusBarHeight}}"
      active="{{moduleIndex === photoModuleIndex}}"
      left-behind="{{moduleIndex > photoModuleIndex}}"
      has-next-module="{{hasNextAfterPhoto}}"
      start-index="{{photoStartIndex}}"
      layout="{{photoWallLayout}}"
      bind:moduledrag="onModuleDrag"
    />

    <!-- ④ 留言/婚礼现场：仅正式请帖 -->
    <bless-board
      wx:if="{{showGuestModules}}"
      id="blessBoard"
      blessings="{{blessings}}"
      stage-photos="{{stagePhotos}}"
      window-height="{{windowHeight}}"
      window-width="{{windowWidth}}"
      status-bar-height="{{statusBarHeight}}"
      active="{{moduleIndex === blessModuleIndex}}"
      bind:moduledrag="onModuleDrag"
      bind:write="onBless"
    />
  </view>

  <!-- 安全区虚线浮层（独立于预览组件，仅草稿预览） -->
  <safe-guide-overlay
    visible="{{enableSafeGuide && showCover && moduleIndex === 0}}"
    window-width="{{windowWidth}}"
    window-height="{{windowHeight}}"
  />

</view>

<view class="bless-sheet" wx:if="{{showGuestModules && blessVisible}}">
  <view class="bless-sheet__mask" catchtap="closeBlessSheet" catchtouchmove="noop"></view>
  <view
    class="bless-sheet__panel {{keyboardHeight > 0 ? 'bless-sheet__panel--kb' : ''}}"
    style="bottom: {{keyboardHeight}}px;"
    catchtouchmove="noop"
  >
    <view class="bless-sheet__bar"></view>
    <view class="bless-sheet__title">写下祝福</view>

    <view class="bless-sheet__field">
      <textarea
        class="bless-sheet__textarea"
        maxlength="120"
        placeholder="把想对新人说的话写在这里…"
        value="{{blessContent}}"
        focus="{{blessFocus}}"
        fixed
        disable-default-padding
        show-confirm-bar="{{false}}"
        cursor-spacing="32"
        adjust-position="{{false}}"
        hold-keyboard
        bindinput="onBlessContentInput"
        bindkeyboardheightchange="onKeyboardHeightChange"
        confirm-type="send"
        bindconfirm="onSubmitBless"
      />
      <view class="bless-sheet__count">{{blessContent.length}}/120</view>
    </view>

    <view class="bless-sheet__actions">
      <view class="bless-sheet__btn">
        <t-button theme="light" size="large" shape="round" block bindtap="closeBlessSheet">取消</t-button>
      </view>
      <view class="bless-sheet__btn">
        <t-button theme="primary" size="large" shape="round" block bindtap="onSubmitBless">发送祝福</t-button>
      </view>
    </view>
  </view>
</view>

<!-- 须挂在页面根上：草稿预览无留言弹层时也要能看大图 -->
<photo-viewer />
